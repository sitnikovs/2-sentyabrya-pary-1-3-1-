@startuml
skinparam classAttributeIconSize 0

interface HttpParser
interface HttpSerializer

class Url
class Request
class Response
class Parser
class Serializer
class Socket
class TcpClient
class TcpServer
class HttpClient
class HttpError
class Router
class HttpServer
class GuiQueueLogHandler
class App
class ClientTab
class ServerTab
